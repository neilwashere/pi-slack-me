{
  "name": "@estebanforge/pi-slack-me",
  "version": "1.3.0",
  "description": "Slack tools and direct commands for Pi that act as YOU, with reviewed writes and an optional global Socket Mode inbox shared across Pi processes.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "slack",
    "slack-api",
    "socket-mode",
    "user-token",
    "chat",
    "coding-agent"
  ],
  "license": "MIT",
  "author": {
    "name": "EstebanForge",
    "email": "esteban@attitude.cl",
    "url": "https://actitud.xyz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neilwashere/pi-slack-me.git"
  },
  "maintainers": [
    {
      "name": "neilwashere",
      "url": "https://github.com/neilwashere"
    }
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "pretest": "npm run build:sidecar",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:sidecar": "esbuild lib/slack-sidecar-entry.ts --bundle --platform=node --format=esm --target=node20 --external:@slack/socket-mode --external:undici --outfile=dist/slack-sidecar.mjs",
    "prepublishOnly": "npm run build:sidecar && npm run typecheck && npm test"
  },
  "files": [
    "extensions",
    "lib",
    "dist",
    "skills",
    "tests",
    "vitest.config.ts",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "@earendil-works/pi-tui": "^0.84.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.1",
    "typebox": "^1.3.4",
    "typescript": "^5.8.0",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@slack/socket-mode": "^3.0.0",
    "undici": "^7.29.0"
  }
}
